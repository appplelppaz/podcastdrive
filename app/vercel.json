{
  "redirects": [
    { "source": "/ipad", "destination": "/ipad/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/ipad/", "destination": "/index.html" },
    { "source": "/ipad/manifest.webmanifest", "destination": "/manifest-ipad.webmanifest" },
    { "source": "/ipad/:path+", "destination": "/:path+" }
  ]
}
